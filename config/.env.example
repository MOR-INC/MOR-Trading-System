# MOR Trading System Configuration

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Robinhood Credentials
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
# Leave empty if not using MFA, otherwise set up TOTP

# Moomoo Settings
# Moomoo requires the OpenD gateway running locally
# Download from: https://www.moomoo.com/download
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_ENV=SIMULATE  # SIMULATE for paper, REAL for live

# TradingView Webhook Secret (optional, for validation)
TV_WEBHOOK_SECRET=

# Audio Alerts
AUDIO_ENABLED=true
AUDIO_VOLUME=0.7

# Dashboard
DASHBOARD_URL=http://localhost:3000
